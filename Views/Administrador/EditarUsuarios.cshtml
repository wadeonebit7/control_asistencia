@model control_asistencia.Models.Usuarios

@{
    ViewData["Title"] = "Editar Usuario: " + (Model.Personal?.Nombre ?? "Desconocido");
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<style>
    body {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f172a 100%);
        min-height: 100vh;
        color: #e2e8f0;
        font-size: 1.05rem;
    }

    .dashboard-card {
        background: rgba(30, 41, 59, 0.75);
        border: 1px solid rgba(56, 189, 248, 0.15);
        border-radius: 20px;
        backdrop-filter: blur(12px);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
    }

    .custom-input, .custom-select {
        background: rgba(15, 23, 42, 0.8) !important;
        border: 1px solid rgba(56, 189, 248, 0.2) !important;
        color: #f8fafc !important;
        border-radius: 10px;
        padding: 12px 16px;
        font-size: 1.05rem;
    }

        .custom-input:focus, .custom-select:focus {
            border-color: #f59e0b !important;
            box-shadow: 0 0 10px rgba(245, 158, 11, 0.3) !important;
        }

    .form-label {
        font-size: 0.95rem;
    }
</style>

<div class="container py-5" style="max-width: 900px;">
    <!-- CABECERA -->
    <div class="d-flex justify-content-between align-items-center mb-4 p-4 dashboard-card">
        <div>
            <h3 class="text-white fw-bold mb-1">
                <i class="bi bi-person-lines-fill text-warning me-2"></i>Edición de Colaborador
            </h3>
            <p class="text-muted mb-0">Modificando el perfil y los accesos de @Model.Personal?.Nombre @Model.Personal?.Apellido</p>
        </div>
        <div>
            <a href="@Url.Action("Index", "Administrador")" class="btn btn-outline-info rounded-pill px-4 py-2">
                <i class="bi bi-arrow-left me-1"></i> Volver al Directorio
            </a>
        </div>
    </div>

    <!-- FORMULARIO DE EDICIÓN -->
    <form asp-action="EditarUsuarios" method="post" class="dashboard-card p-5">

        <!-- Inputs ocultos para mantener las llaves primarias en el controlador -->
        <input type="hidden" name="Id" value="@Model.Id" />
        <input type="hidden" name="IdPersonal" value="@Model.IdPersonal" />
        <input type="hidden" name="Personal.Id" value="@Model.Personal?.Id" />

        <!-- SECCIÓN 1: DATOS PERSONALES -->
        <h5 class="text-info mb-4 border-bottom border-info border-opacity-25 pb-2">
            <i class="bi bi-card-heading me-2"></i>Datos Personales
        </h5>

        <div class="row g-4 mb-5">
            <div class="col-md-4">
                <label class="form-label text-muted fw-semibold">RUT</label>
                <input type="text" name="Personal.Rut" value="@Model.Personal?.Rut" class="form-control custom-input" required />
            </div>
            <div class="col-md-4">
                <label class="form-label text-muted fw-semibold">Nombre</label>
                <input type="text" name="Personal.Nombre" value="@Model.Personal?.Nombre" class="form-control custom-input" required />
            </div>
            <div class="col-md-4">
                <label class="form-label text-muted fw-semibold">Apellido</label>
                <input type="text" name="Personal.Apellido" value="@Model.Personal?.Apellido" class="form-control custom-input" required />
            </div>
            <div class="col-md-6">
                <label class="form-label text-muted fw-semibold">Correo Electrónico</label>
                <input type="email" name="Personal.Correo" value="@Model.Personal?.Correo" class="form-control custom-input" required />
            </div>
            <div class="col-md-6">
                <label class="form-label text-muted fw-semibold">Número de Celular</label>
                <input type="text" name="Personal.Celular" value="@Model.Personal?.Celular" class="form-control custom-input" required />
            </div>
            <div class="col-md-12">
                <label class="form-label text-muted fw-semibold">Dirección de Residencia</label>
                <input type="text" name="Personal.Direccion" value="@Model.Personal?.Direccion" class="form-control custom-input" required />
            </div>
        </div>

        <!-- SECCIÓN 2: CREDENCIALES Y ESTADO -->
        <h5 class="text-warning mb-4 border-bottom border-warning border-opacity-25 pb-2">
            <i class="bi bi-shield-lock me-2"></i>Credenciales y Estado de la Cuenta
        </h5>

        <div class="row g-4 mb-4">
            <div class="col-md-4">
                <label class="form-label text-muted fw-semibold">Rol del Sistema</label>
                <!-- Según tu base de datos: 1=EMPLEADO, 2=RRHH, 3=ADMIN -->
                <select name="Personal.IdRol" class="form-select custom-select">
                    <option value="1" selected="@(Model.Personal?.IdRol == 1)">EMPLEADO</option>
                    <option value="2" selected="@(Model.Personal?.IdRol == 2)">RRHH</option>
                    <option value="3" selected="@(Model.Personal?.IdRol == 3)">ADMIN</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label text-muted fw-semibold">Estatus Médico / Laboral</label>
                <select name="Status" class="form-select custom-select">
                    <option value="ACTIVO" selected="@(Model.Status == "ACTIVO")">ACTIVO</option>
                    <option value="LICENCIA" selected="@(Model.Status == "LICENCIA")">EN LICENCIA</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label text-muted fw-semibold">Cambiar Contraseña</label>
                <input type="password" name="Password" class="form-control custom-input" placeholder="(Opcional) Dejar en blanco para omitir" />
                <div class="form-text text-muted small mt-1">Si no escribes nada, la contraseña actual se mantendrá.</div>
            </div>
        </div>

        <div class="mb-4 form-check form-switch fs-5 mt-4 p-4 rounded" style="background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.05);">
            <input type="hidden" name="Estado" value="false" /> <!-- Truco para evitar nulos en C# si se desmarca el check -->
            <input class="form-check-input ms-0 me-3" type="checkbox" id="estadoCuenta" name="Estado" value="true" @(Model.Estado ? "checked" : "")>
            <label class="form-check-label text-white" for="estadoCuenta" style="cursor: pointer;">
                Cuenta Habilitada (Permitir inicio de sesión y marcación)
            </label>
        </div>

        <!-- BOTONERA -->
        <div class="d-flex justify-content-end gap-3 mt-5 pt-3 border-top border-secondary border-opacity-25">
            <a href="@Url.Action("Index", "Administrador")" class="btn btn-outline-secondary px-4 py-2 fw-semibold">
                Cancelar
            </a>
            <button type="submit" class="btn btn-warning text-dark px-5 py-2 fw-bold">
                <i class="bi bi-save-fill me-2"></i> Guardar Cambios
            </button>
        </div>

    </form>
</div>