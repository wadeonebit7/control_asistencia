@model IEnumerable<control_asistencia.Models.Personal>

@{
    ViewData["Title"] = "Gestión de Personal - RRHH";
}

<style>
    body {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f172a 100%) !important;
        color: #e2e8f0 !important;
        min-height: 100vh;
    }

    .dashboard-card {
        background: rgba(30, 41, 59, 0.85);
        border: 1px solid rgba(56, 189, 248, 0.15);
        border-radius: 16px;
        backdrop-filter: blur(12px);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    }

    .table-custom {
        color: #f8fafc !important;
    }

        .table-custom th {
            border-bottom: 2px solid rgba(255, 255, 255, 0.1) !important;
            color: #94a3b8 !important;
            font-size: 0.8rem;
            letter-spacing: 0.5px;
        }

        .table-custom td {
            border-bottom: 1px solid rgba(255, 255, 255, 0.05) !important;
            color: #e2e8f0 !important;
            vertical-align: middle;
        }
</style>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<div class="container py-4">
    <div class="dashboard-card p-4 mb-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div class="d-flex align-items-center">
            <div class="p-3 rounded-circle bg-info bg-opacity-10 text-info me-3 d-none d-sm-flex align-items-center justify-content-center" style="width: 55px; height: 55px;">
                <i class="bi bi-people-fill fs-4"></i>
            </div>
            <div>
                <h3 class="text-white fw-bold mb-1">Gestión de Personal</h3>
                <p class="text-muted mb-0 small">Administra el listado oficial de trabajadores de la empresa.</p>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Index", "RecursosHumanos")" class="btn btn-outline-secondary btn-sm rounded-pill px-3 shadow-sm">
                <i class="bi bi-arrow-left me-1"></i> Volver al Panel
            </a>
            <a href="@Url.Action("CrearPersonal", "RecursosHumanos")" class="btn btn-info btn-sm rounded-pill px-4 fw-bold shadow-sm" style="color: #0f172a;">
                <i class="bi bi-person-plus-fill me-1"></i> Nuevo Personal
            </a>
        </div>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-success border-opacity-25 bg-success bg-opacity-10 text-success shadow-sm rounded-4 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Mensaje"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="dashboard-card p-4">
        <div class="table-responsive">
            <table class="table table-custom align-middle text-nowrap">
                <thead>
                    <tr>
                        <th>RUT</th>
                        <th>NOMBRE COMPLETO</th>
                        <th>CORREO</th>
                        <th>CELULAR</th>
                        <th>ROL</th>
                        <th class="text-center">ACCIONES</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td><span class="font-monospace fw-semibold text-white">@item.Rut</span></td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-sm bg-info bg-opacity-10 rounded-circle text-info d-flex align-items-center justify-content-center fw-bold me-2" style="width: 32px; height: 32px; font-size: 0.85rem;">
                                            @item.Nombre.Substring(0, 1)
                                        </div>
                                        <span class="text-white fw-medium">@item.Nombre @item.Apellido</span>
                                    </div>
                                </td>
                                <td class="text-muted">@item.Correo</td>
                                <td class="text-muted">@item.Celular</td>
                                <td>
                                    @if (item.Rol.Nombre == "ADMIN")
                                    {
                                        <!-- Corregido: texto blanco y legible -->
                                        <span class="badge bg-danger text-white px-3 py-1 rounded-pill fw-semibold">@item.Rol.Nombre</span>
                                    }
                                    else if (item.Rol.Nombre == "RRHH")
                                    {
                                        <span class="badge bg-warning text-dark px-3 py-1 rounded-pill fw-semibold">@item.Rol.Nombre</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info text-dark px-3 py-1 rounded-pill fw-semibold">@item.Rol.Nombre</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-2">
                                        <a href="@Url.Action("EditarPersonal", "RecursosHumanos", new { id = item.Id })" class="btn btn-sm btn-outline-info rounded-pill px-3 shadow-sm" title="Editar">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <form asp-action="EliminarPersonal" asp-route-id="@item.Id" method="post" onsubmit="return confirm('¿Estás seguro de que deseas desactivar al trabajador @item.Nombre @item.Apellido?');" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3 shadow-sm" title="Desactivar">
                                                <i class="bi bi-person-x-fill"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-5">No hay personal activo registrado.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>