@model control_asistencia.Models.Personal

@{
    ViewData["Title"] = "Nuevo Personal - RRHH";
}

<style>
    body {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f172a 100%) !important;
        color: #e2e8f0 !important;
        min-height: 100vh;
    }

    .dashboard-card {
        background: rgba(30, 41, 59, 0.85);
        border: 1px solid rgba(56, 189, 248, 0.15);
        border-radius: 16px;
        backdrop-filter: blur(12px);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    }
</style>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<div class="container py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 p-4 dashboard-card gap-3">
        <div class="d-flex align-items-center">
            <div class="p-3 rounded-circle bg-info bg-opacity-10 text-info me-3 d-none d-sm-flex align-items-center justify-content-center" style="width: 55px; height: 55px;">
                <i class="bi bi-person-plus fs-4"></i>
            </div>
            <div>
                <h3 class="text-white fw-bold mb-1">Registrar Nuevo Trabajador</h3>
                <p class="text-muted mb-0 small">Completa los datos para ingresar a un nuevo empleado al sistema.</p>
            </div>
        </div>
        <div>
            <a href="@Url.Action("Personal", "RecursosHumanos")" class="btn btn-outline-secondary btn-sm rounded-pill px-4 shadow-sm">
                <i class="bi bi-arrow-left me-1"></i> Volver al Listado
            </a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="dashboard-card p-4">
                <form asp-action="CrearPersonal" method="post">
                    @Html.AntiForgeryToken()

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Rut" class="form-label text-muted small fw-bold text-uppercase">RUT</label>
                            <input asp-for="Rut" class="form-control bg-dark text-white border-secondary border-opacity-50 py-2" placeholder="Ej: 12345678-9" required />
                            <span asp-validation-for="Rut" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="IdRol" class="form-label text-muted small fw-bold text-uppercase">Rol Asignado</label>
                            <select asp-for="IdRol" asp-items="@(new SelectList(ViewBag.Roles, "Id", "Nombre"))" class="form-select bg-dark text-white border-secondary border-opacity-50 py-2" required>
                                <option value="" disabled selected>-- Seleccione un Rol --</option>
                            </select>
                            <span asp-validation-for="IdRol" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Nombre" class="form-label text-muted small fw-bold text-uppercase">Nombres</label>
                            <input asp-for="Nombre" class="form-control bg-dark text-white border-secondary border-opacity-50 py-2" required />
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Apellido" class="form-label text-muted small fw-bold text-uppercase">Apellidos</label>
                            <input asp-for="Apellido" class="form-control bg-dark text-white border-secondary border-opacity-50 py-2" required />
                            <span asp-validation-for="Apellido" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Correo" class="form-label text-muted small fw-bold text-uppercase">Correo Electrónico</label>
                        <input asp-for="Correo" type="email" class="form-control bg-dark text-white border-secondary border-opacity-50 py-2" placeholder="correo@empresa.com" required />
                        <span asp-validation-for="Correo" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-8">
                            <label asp-for="Direccion" class="form-label text-muted small fw-bold text-uppercase">Dirección</label>
                            <input asp-for="Direccion" class="form-control bg-dark text-white border-secondary border-opacity-50 py-2" required />
                            <span asp-validation-for="Direccion" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Celular" class="form-label text-muted small fw-bold text-uppercase">Celular</label>
                            <input asp-for="Celular" class="form-control bg-dark text-white border-secondary border-opacity-50 py-2" placeholder="+569..." required />
                            <span asp-validation-for="Celular" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <a href="@Url.Action("Personal", "RecursosHumanos")" class="text-muted text-decoration-none small">
                            <i class="bi bi-arrow-left me-1"></i> Cancelar
                        </a>
                        <button type="submit" class="btn btn-info px-5 py-2 fw-bold rounded-pill shadow-sm" style="color: #0f172a;">
                            <i class="bi bi-save-fill me-2"></i> Guardar Trabajador
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>