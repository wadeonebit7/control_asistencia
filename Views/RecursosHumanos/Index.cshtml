<div class="d-flex justify-content-between align-items-center mb-4 p-4 dashboard-card">
    <div>
        <h3 class="text-white fw-bold mb-1">¡Hola, @User.Identity.Name!</h3>
        <p class="text-muted mb-0 small"><i class="bi bi-shield-check text-info me-1"></i> Rol: @User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value</p>
    </div>
    <div>
        <a href="@Url.Action("Logout", "Auth")" class="btn btn-outline-danger btn-sm rounded-pill px-3">
            <i class="bi bi-box-arrow-right me-1"></i> Cerrar Sesión
        </a>
    </div>
</div>
