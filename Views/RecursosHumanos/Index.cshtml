@model IEnumerable<control_asistencia.Models.Solicitudes>

@{
    ViewData["Title"] = "Dashboard - Recursos Humanos";
}

<div class="container py-4">
    <!-- Encabezado de Bienvenida -->
    <div class="d-flex justify-content-between align-items-center mb-4 p-4 dashboard-card">
        <div>
            <h3 class="text-white fw-bold mb-1">¡Hola, @User.Identity.Name!</h3>
            <p class="text-muted mb-0 small"><i class="bi bi-shield-check text-warning me-1"></i> Panel de Administración de Recursos Humanos</p>
        </div>
        <div>
            <a href="@Url.Action("Personal", "RecursosHumanos")" class="btn btn-outline-info btn-sm rounded-pill px-3 me-2">
                <i class="bi bi-people-fill me-1"></i> Gestionar Personal
            </a>
            <a href="@Url.Action("Logout", "Auth")" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                <i class="bi bi-box-arrow-right me-1"></i> Salir
            </a>
        </div>
    </div>

    <!-- Tarjetas de Resumen (KPIs) -->
    <div class="row mb-4 g-3">
        <!-- Tarjeta Pendientes -->
        <div class="col-md-4">
            <div class="dashboard-card p-4 h-100 d-flex align-items-center" style="border-left: 4px solid #f59e0b;">
                <div class="me-3">
                    <i class="bi bi-hourglass-split p-3 rounded-circle" style="font-size: 2rem; color: #f59e0b; background: rgba(245, 158, 11, 0.1);"></i>
                </div>
                <div>
                    <h2 class="text-white fw-bold mb-0">@ViewBag.TotalPendientes</h2>
                    <p class="text-muted small mb-0">Solicitudes Pendientes</p>
                </div>
            </div>
        </div>
        <!-- Tarjeta Aprobadas -->
        <div class="col-md-4">
            <div class="dashboard-card p-4 h-100 d-flex align-items-center" style="border-left: 4px solid #10b981;">
                <div class="me-3">
                    <i class="bi bi-check-circle-fill p-3 rounded-circle" style="font-size: 2rem; color: #10b981; background: rgba(16, 185, 129, 0.1);"></i>
                </div>
                <div>
                    <h2 class="text-white fw-bold mb-0">@ViewBag.TotalAprobadas</h2>
                    <p class="text-muted small mb-0">Solicitudes Aprobadas</p>
                </div>
            </div>
        </div>
        <!-- Tarjeta Rechazadas -->
        <div class="col-md-4">
            <div class="dashboard-card p-4 h-100 d-flex align-items-center" style="border-left: 4px solid #ef4444;">
                <div class="me-3">
                    <i class="bi bi-x-circle-fill p-3 rounded-circle" style="font-size: 2rem; color: #ef4444; background: rgba(239, 68, 68, 0.1);"></i>
                </div>
                <div>
                    <h2 class="text-white fw-bold mb-0">@ViewBag.TotalRechazadas</h2>
                    <p class="text-muted small mb-0">Solicitudes Rechazadas</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Alertas de TempData -->
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-success border-opacity-25 bg-success bg-opacity-10 text-success shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Mensaje"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Tabla de Solicitudes Entrantes -->
    <div class="dashboard-card p-4">
        <h5 class="text-white mb-4"><i class="bi bi-inbox-fill text-info me-2"></i>Bandeja de Entrada de Solicitudes</h5>

        <div class="table-responsive">
            <table class="table table-custom align-middle">
                <thead>
                    <tr>
                        <th>Fecha Ingreso</th>
                        <th>Trabajador</th>
                        <th>RUT</th>
                        <th>Tipo Trámite</th>
                        <th>Motivo Principal</th>
                        <th class="text-center">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-muted small">@item.CreateAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="fw-semibold text-white">@item.Usuario.Personal.Nombre @item.Usuario.Personal.Apellido</td>
                                <td class="text-muted small">@item.Usuario.Personal.Rut</td>
                                <td>
                                    @if (item.TipoSolicitud == "LICENCIA_MEDICA")
                                    {
                                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2 py-1"><i class="bi bi-heart-pulse-fill me-1"></i>Licencia Médica</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 px-2 py-1"><i class="bi bi-calendar2-check-fill me-1"></i>Ajuste Asistencia</span>
                                    }
                                </td>
                                <td>
                                    <!-- Cortamos el texto si es muy largo para que no deforme la tabla -->
                                    <span class="text-muted" title="@item.Motivo">
                                        @(item.Motivo.Length > 30 ? item.Motivo.Substring(0, 30) + "..." : item.Motivo)
                                    </span>
                                </td>
                                <td class="text-center">
                                    <a href="@Url.Action("RevisarSolicitud", "RecursosHumanos", new { id = item.Id })" class="btn btn-sm btn-info rounded-pill px-3 fw-bold" style="color: #0f172a;">
                                        Revisar <i class="bi bi-arrow-right-short"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-5">
                                <i class="bi bi-emoji-smile fs-3 d-block mb-2 text-secondary"></i>
                                Todo al día. No hay solicitudes pendientes por revisar.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>