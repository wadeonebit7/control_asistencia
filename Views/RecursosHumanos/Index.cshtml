@model IEnumerable<control_asistencia.Models.Solicitudes>

@{
    ViewData["Title"] = "Dashboard - Recursos Humanos";
}

<style>
    body {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f172a 100%) !important;
        color: #e2e8f0 !important;
        min-height: 100vh;
    }

    .dashboard-card {
        background: rgba(30, 41, 59, 0.85);
        border: 1px solid rgba(56, 189, 248, 0.15);
        border-radius: 16px;
        backdrop-filter: blur(12px);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    }

    .table-custom {
        color: #f8fafc !important;
    }

        .table-custom th {
            border-bottom: 2px solid rgba(255, 255, 255, 0.1) !important;
            color: #94a3b8 !important;
            font-size: 0.8rem;
            letter-spacing: 0.5px;
        }

        .table-custom td {
            border-bottom: 1px solid rgba(255, 255, 255, 0.05) !important;
            color: #e2e8f0 !important;
            vertical-align: middle;
        }
</style>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<div class="container py-4">
    <!-- Encabezado de Bienvenida -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 p-4 dashboard-card gap-3">
        <div class="d-flex align-items-center">
            <div class="p-3 rounded-circle bg-info bg-opacity-10 text-info me-3 d-none d-sm-flex align-items-center justify-content-center" style="width: 55px; height: 55px;">
                <i class="bi bi-person-workspace fs-4"></i>
            </div>
            <div>
                <h3 class="text-white fw-bold mb-1">¡Hola, @User.Identity.Name!</h3>
                <p class="text-muted mb-0 small"><i class="bi bi-shield-check text-warning me-1"></i> Panel de Administración de Recursos Humanos</p>
            </div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a href="@Url.Action("Personal", "RecursosHumanos")" class="btn btn-outline-info btn-sm rounded-pill px-4 fw-semibold shadow-sm">
                <i class="bi bi-people-fill me-1"></i> Gestionar Personal
            </a>
            <a href="@Url.Action("Logout", "Auth")" class="btn btn-outline-danger btn-sm rounded-pill px-3 shadow-sm">
                <i class="bi bi-box-arrow-right me-1"></i> Salir
            </a>
        </div>
    </div>

    <!-- Tarjetas de Resumen (KPIs) -->
    <div class="row mb-4 g-3">
        <div class="col-md-4">
            <div class="dashboard-card p-4 h-100 d-flex align-items-center border-0" style="border-left: 4px solid #f59e0b !important;">
                <div class="me-3">
                    <i class="bi bi-hourglass-split p-3 rounded-circle d-flex align-items-center justify-content-center" style="font-size: 1.6rem; color: #f59e0b; background: rgba(245, 158, 11, 0.1); width: 50px; height: 50px;"></i>
                </div>
                <div>
                    <h2 class="text-white fw-bold mb-0">@ViewBag.TotalPendientes</h2>
                    <p class="text-muted small mb-0 fw-medium">Solicitudes Pendientes</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="dashboard-card p-4 h-100 d-flex align-items-center border-0" style="border-left: 4px solid #10b981 !important;">
                <div class="me-3">
                    <i class="bi bi-check-circle-fill p-3 rounded-circle d-flex align-items-center justify-content-center" style="font-size: 1.6rem; color: #10b981; background: rgba(16, 185, 129, 0.1); width: 50px; height: 50px;"></i>
                </div>
                <div>
                    <h2 class="text-white fw-bold mb-0">@ViewBag.TotalAprobadas</h2>
                    <p class="text-muted small mb-0 fw-medium">Solicitudes Aprobadas</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="dashboard-card p-4 h-100 d-flex align-items-center border-0" style="border-left: 4px solid #ef4444 !important;">
                <div class="me-3">
                    <i class="bi bi-x-circle-fill p-3 rounded-circle d-flex align-items-center justify-content-center" style="font-size: 1.6rem; color: #ef4444; background: rgba(239, 68, 68, 0.1); width: 50px; height: 50px;"></i>
                </div>
                <div>
                    <h2 class="text-white fw-bold mb-0">@ViewBag.TotalRechazadas</h2>
                    <p class="text-muted small mb-0 fw-medium">Solicitudes Rechazadas</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Alertas -->
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-success border-opacity-25 bg-success bg-opacity-10 text-success shadow-sm rounded-4 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Mensaje"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Tabla de Solicitudes -->
    <div class="dashboard-card p-4">
        <div class="d-flex align-items-center mb-4">
            <i class="bi bi-inbox-fill text-info fs-4 me-2"></i>
            <h5 class="text-white mb-0 fw-bold">Bandeja de Entrada de Solicitudes</h5>
        </div>

        <div class="table-responsive">
            <table class="table table-custom align-middle text-nowrap">
                <thead>
                    <tr>
                        <th>FECHA INGRESO</th>
                        <th>TRABAJADOR</th>
                        <th>RUT</th>
                        <th>TIPO TRÁMITE</th>
                        <th>MOTIVO PRINCIPAL</th>
                        <th class="text-center">ACCIÓN</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-muted small">@item.CreateAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-sm bg-info bg-opacity-10 rounded-circle text-info d-flex align-items-center justify-content-center fw-bold me-2" style="width: 32px; height: 32px; font-size: 0.85rem;">
                                            @item.Usuario.Personal.Nombre.Substring(0, 1)
                                        </div>
                                        <span class="fw-semibold text-white">@item.Usuario.Personal.Nombre @item.Usuario.Personal.Apellido</span>
                                    </div>
                                </td>
                                <td><span class="font-monospace text-muted small">@item.Usuario.Personal.Rut</span></td>
                                <td>
                                    @if (item.TipoSolicitud == "LICENCIA_MEDICA")
                                    {
                                        <!-- Corregido: texto claro y visible -->
                                        <span class="badge bg-primary text-white px-3 py-1.5 rounded-pill fw-semibold"><i class="bi bi-heart-pulse-fill me-1"></i>Licencia Médica</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info text-dark px-3 py-1.5 rounded-pill fw-semibold"><i class="bi bi-calendar2-check-fill me-1"></i>Ajuste Asistencia</span>
                                    }
                                </td>
                                <td>
                                    <span class="text-muted text-wrap" style="max-width: 250px; display: inline-block;" title="@item.Motivo">
                                        @(item.Motivo.Length > 30 ? item.Motivo.Substring(0, 30) + "..." : item.Motivo)
                                    </span>
                                </td>
                                <td class="text-center">
                                    <a href="@Url.Action("RevisarSolicitud", "RecursosHumanos", new { id = item.Id })" class="btn btn-sm btn-info rounded-pill px-4 fw-bold shadow-sm" style="color: #0f172a;">
                                        Revisar <i class="bi bi-arrow-right-short ms-1"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-5">
                                <i class="bi bi-emoji-smile fs-2 d-block mb-2 text-secondary opacity-50"></i>
                                Todo al día. No hay solicitudes pendientes por revisar.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>