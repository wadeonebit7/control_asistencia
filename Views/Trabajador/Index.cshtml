@model IEnumerable<control_asistencia.Models.Asistencia>
@using System.Security.Claims

@{
    ViewData["Title"] = "Panel de Empleado - Control de Asistencia";

    // Si la URL no trae un mes explícito, por defecto seleccionamos el mes actual
    int mesActualPorDefecto = DateTime.Now.Month;
    int mesSeleccionado = mesActualPorDefecto;

    if (Context.Request.Query.ContainsKey("mes"))
    {
        int.TryParse(Context.Request.Query["mes"], out mesSeleccionado);
    }
}

@functions {
    public int ObtenerSemanaDelMes(DateTime fecha)
    {
        var cal = System.Globalization.CultureInfo.InvariantCulture.Calendar;
        int semanaPrimerDia = cal.GetWeekOfYear(new DateTime(fecha.Year, fecha.Month, 1), System.Globalization.CalendarWeekRule.FirstDay, DayOfWeek.Monday);
        int semanaActual = cal.GetWeekOfYear(fecha, System.Globalization.CalendarWeekRule.FirstDay, DayOfWeek.Monday);
        return semanaActual - semanaPrimerDia + 1;
    }
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<style>
    body {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f172a 100%);
        min-height: 100vh;
        color: #e2e8f0;
    }

    .dashboard-card {
        background: rgba(30, 41, 59, 0.75);
        border: 1px solid rgba(56, 189, 248, 0.15);
        border-radius: 20px;
        backdrop-filter: blur(12px);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
    }

    .nav-pills .nav-link {
        color: #94a3b8;
        background: rgba(15, 23, 42, 0.4);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 12px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .nav-pills .nav-link:hover {
            color: #38bdf8;
            background: rgba(56, 189, 248, 0.1);
        }

        .nav-pills .nav-link.active {
            color: #ffffff;
            background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
            box-shadow: 0 4px 15px rgba(2, 132, 199, 0.4);
        }

    .custom-select-month, .custom-input-field {
        background: rgba(15, 23, 42, 0.8) !important;
        border: 1px solid rgba(56, 189, 248, 0.2) !important;
        color: #f8fafc !important;
        border-radius: 10px;
        padding: 10px 14px;
    }

        .custom-input-field:focus {
            border-color: #38bdf8 !important;
            box-shadow: 0 0 0 0.2rem rgba(56, 189, 248, 0.25) !important;
        }

        .custom-input-field[readonly] {
            background: rgba(15, 23, 42, 0.4) !important;
            color: #cbd5e1 !important;
            cursor: not-allowed;
            border-style: dashed !important;
        }

    .table-custom {
        color: #e2e8f0;
        background: transparent;
    }

        .table-custom th {
            border-color: rgba(255, 255, 255, 0.1);
            color: #38bdf8;
            font-weight: 600;
        }

        .table-custom td {
            border-color: rgba(255, 255, 255, 0.05);
            vertical-align: middle;
        }

    .semana-header {
        background: rgba(56, 189, 248, 0.08);
        border-top: 1px solid rgba(56, 189, 248, 0.2) !important;
        border-bottom: 1px solid rgba(56, 189, 248, 0.2) !important;
    }

    .dynamic-code-box {
        background: rgba(15, 23, 42, 0.9);
        border: 2px dashed rgba(56, 189, 248, 0.4);
        border-radius: 15px;
        letter-spacing: 4px;
        font-size: 2.5rem;
        color: #38bdf8;
        font-weight: 800;
    }

    .btn-submit-custom {
        background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
        border: none;
        border-radius: 10px;
        padding: 12px 20px;
        font-weight: 600;
        color: #fff;
        transition: all 0.3s ease;
    }

        .btn-submit-custom:hover {
            background: linear-gradient(135deg, #0369a1 100%, #075985 100%);
            transform: translateY(-2px);
        }

    .spin-icon {
        animation: spin 1.5s linear infinite;
        display: inline-block;
    }

    @@keyframes spin {
        100% {
            transform: rotate(360deg);
        }
    }

    .highlight-ocr {
        animation: pulseOcr 2s ease-out;
        border-color: #10b981 !important;
        background: rgba(16, 185, 129, 0.1) !important;
    }

    @@keyframes pulseOcr {
        0% {
            box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
        }

        70% {
            box-shadow: 0 0 0 10px rgba(16, 185, 129, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(16, 185, 129, 0);
        }
    }
</style>

<!-- BIENVENIDA AL USUARIO -->
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 p-4 dashboard-card">
        <div>
            <h3 class="text-white fw-bold mb-1">¡Hola, @User.Identity.Name!</h3>
            <p class="text-muted mb-0 small"><i class="bi bi-shield-check text-info me-1"></i> Rol: @User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value</p>
        </div>
        <div>
            <a href="@Url.Action("Logout", "Auth")" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                <i class="bi bi-box-arrow-right me-1"></i> Cerrar Sesión
            </a>
        </div>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show dashboard-card border-success text-success mb-4" role="alert" style="background: rgba(16, 185, 129, 0.1) !important;">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Mensaje"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show dashboard-card border-danger text-danger mb-4" role="alert" style="background: rgba(239, 68, 68, 0.1) !important;">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Navegación -->
    <ul class="nav nav-pills mb-4 gap-2" id="employeeTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active px-4 py-2" id="codigo-tab" data-bs-toggle="pill" data-bs-target="#codigo-pane" type="button" role="tab" aria-selected="true">
                <i class="bi bi-ticket-perforated me-2"></i> Mi Código Dinámico
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link px-4 py-2" id="asistencia-tab" data-bs-toggle="pill" data-bs-target="#asistencia-pane" type="button" role="tab" aria-selected="false">
                <i class="bi bi-calendar-check me-2"></i> Mi Asistencia
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link px-4 py-2" id="justificacion-tab" data-bs-toggle="pill" data-bs-target="#justificacion-pane" type="button" role="tab" aria-selected="false">
                <i class="bi bi-file-earmark-text me-2"></i> Nueva Justificación
            </button>
        </li>
        <!-- NUEVA PESTAÑA: MIS SOLICITUDES -->
        <li class="nav-item" role="presentation">
            <button class="nav-link px-4 py-2" id="mis-solicitudes-tab" data-bs-toggle="pill" data-bs-target="#mis-solicitudes-pane" type="button" role="tab" aria-selected="false">
                <i class="bi bi-folder2-open me-2"></i> Mis Solicitudes
            </button>
        </li>
    </ul>

    <div class="tab-content" id="employeeTabContent">

        <!-- PESTAÑA 1: CÓDIGO DINÁMICO -->
        <div class="tab-pane fade show active" id="codigo-pane" role="tabpanel">
            <div class="dashboard-card p-5 text-center" style="max-width: 600px; margin: 0 auto;">
                <div class="mb-3">
                    <i class="bi bi-key text-info" style="font-size: 3rem;"></i>
                </div>
                <h4 class="text-white mb-2">Tu Clave Dinámica de Acceso</h4>
                <p class="text-muted small mb-4">Usa este código único para fichar o autenticarte de forma rápida.</p>

                <div class="dynamic-code-box py-3 px-4 mb-4 shadow-inner" id="displayCode">
                    CARGANDO...
                </div>

                <!-- Barra de tiempo -->
                <div class="px-4">
                    <div class="progress" style="height: 6px; background-color: rgba(15, 23, 42, 0.5); border-radius: 10px;">
                        <div id="codeProgressBar" class="progress-bar bg-info" role="progressbar" style="width: 100%; transition: width 1s linear;"></div>
                    </div>
                    <small class="text-muted mt-2 d-block" id="codeTimerText">Sincronizando con servidor...</small>
                </div>
            </div>
        </div>

        <!-- PESTAÑA 2: ASISTENCIA -->
        <div class="tab-pane fade" id="asistencia-pane" role="tabpanel">
            <div class="dashboard-card p-4">
                <div class="row align-items-center mb-4">
                    <div class="col-md-4">
                        <h5 class="text-white mb-0"><i class="bi bi-clock-history text-info me-2"></i>Historial de Asistencia</h5>
                    </div>
                    <div class="col-md-4 offset-md-4">
                        <div class="d-flex align-items-center gap-2">
                            <label class="text-muted small text-nowrap">Filtrar Mes:</label>
                            <select class="form-select custom-select-month form-select-sm" id="selectMes">
                                <option value="1" selected="@(mesSeleccionado == 1 ? "selected" : null)">Enero 2026</option>
                                <option value="2" selected="@(mesSeleccionado == 2 ? "selected" : null)">Febrero 2026</option>
                                <option value="3" selected="@(mesSeleccionado == 3 ? "selected" : null)">Marzo 2026</option>
                                <option value="4" selected="@(mesSeleccionado == 4 ? "selected" : null)">Abril 2026</option>
                                <option value="5" selected="@(mesSeleccionado == 5 ? "selected" : null)">Mayo 2026</option>
                                <option value="6" selected="@(mesSeleccionado == 6 ? "selected" : null)">Junio 2026</option>
                                <option value="7" selected="@(mesSeleccionado == 7 ? "selected" : null)">Julio 2026</option>
                                <option value="8" selected="@(mesSeleccionado == 8 ? "selected" : null)">Agosto 2026</option>
                                <option value="9" selected="@(mesSeleccionado == 9 ? "selected" : null)">Septiembre 2026</option>
                                <option value="10" selected="@(mesSeleccionado == 10 ? "selected" : null)">Octubre 2026</option>
                                <option value="11" selected="@(mesSeleccionado == 11 ? "selected" : null)">Noviembre 2026</option>
                                <option value="12" selected="@(mesSeleccionado == 12 ? "selected" : null)">Diciembre 2026</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-custom align-middle">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Entrada Real</th>
                                <th>Salida Real</th>
                                <th>Horas Trabajadas</th>
                                <th>Estado Entrada</th>
                                <th>Estado Salida</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                var gruposPorSemana = Model.GroupBy(a => ObtenerSemanaDelMes(a.CreateAt))
                                                         .OrderByDescending(g => g.Key);

                                foreach (var grupo in gruposPorSemana)
                                {
                                    double totalSegundosSemana = grupo.Where(i => i.HoraSalidaReal.TotalSeconds > 0)
                                                                      .Sum(i => i.HoraSalidaReal.Subtract(i.HoraEntradaReal).TotalSeconds);
                                    TimeSpan tiempoTotalSemana = TimeSpan.FromSeconds(totalSegundosSemana);
                                    string textoTotalSemana = $"{(int)tiempoTotalSemana.TotalHours:D2}:{tiempoTotalSemana.Minutes:D2} hrs";

                                    <tr class="semana-header">
                                        <td colspan="3" class="text-info fw-bold py-2">
                                            <i class="bi bi-calendar3-week me-2"></i> Semana @grupo.Key
                                        </td>
                                        <td colspan="3" class="text-end text-info fw-bold py-2 pe-4">
                                            <i class="bi bi-stopwatch me-1"></i> Total Semana: @textoTotalSemana
                                        </td>
                                    </tr>
                                    foreach (var item in grupo)
                                    {
                                        TimeSpan horasTrabajadas = item.HoraSalidaReal.Subtract(item.HoraEntradaReal);
                                        string textoHoras = item.HoraSalidaReal.TotalSeconds > 0
                                                            ? $"{(int)horasTrabajadas.TotalHours:D2}:{horasTrabajadas.Minutes:D2} hrs"
                                                            : "--:--";
                                        <tr>
                                            <td class="ps-4">@item.CreateAt.ToShortDateString()</td>
                                            <td>@item.HoraEntradaReal</td>
                                            <td>@item.HoraSalidaReal</td>
                                            <td class="fw-semibold text-info">@textoHoras</td>
                                            <td>
                                                @if (item.EstadoEntrada == "MARCADA")
                                                {
                                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">MARCADA</span>
                                                }
                                                else if (item.EstadoEntrada == "ATRASADO")
                                                {
                                                    <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-2 py-1">ATRASADO</span>
                                                }
                                                else if (item.EstadoEntrada == "LICENCIA")
                                                {
                                                    <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 px-2 py-1">LICENCIA</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-2 py-1">@item.EstadoEntrada</span>
                                                }
                                            </td>
                                            <td>
                                                @if (item.EstadoSalida == "MARCADA")
                                                {
                                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">MARCADA</span>
                                                }
                                                else if (item.EstadoSalida == "ANTICIPADO")
                                                {
                                                    <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-2 py-1">ANTICIPADO</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-2 py-1">@item.EstadoSalida</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-4">No hay registros de asistencia para este mes.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- PESTAÑA 3: NUEVA SECCIÓN DE JUSTIFICACIÓN -->
        <div class="tab-pane fade" id="justificacion-pane" role="tabpanel">
            <div class="row">
                <!-- Columna Izquierda: Formulario Dinámico -->
                <div class="col-lg-6 mb-4">
                    <div class="dashboard-card p-4 h-100">
                        <div class="text-center mb-4">
                            <i class="bi bi-file-earmark-medical text-info" style="font-size: 2.5rem;"></i>
                            <h4 class="text-white mt-2">Enviar Solicitud</h4>
                            <p class="text-muted small">Selecciona el tipo de trámite y adjunta el respaldo.</p>
                        </div>

                        <form asp-controller="Solicitudes" asp-action="CrearSolicitud" method="post" enctype="multipart/form-data" id="formJustificacion">
                            @Html.AntiForgeryToken()

                            <!-- Tipo de Justificación -->
                            <div class="mb-3">
                                <label class="form-label text-muted small fw-semibold">Tipo de Justificación</label>
                                <select id="tipoSolicitud" name="tipoSolicitud" class="form-select custom-input-field" required>
                                    <option value="" disabled selected>-- Seleccione una opción --</option>
                                    <option value="LICENCIA_MEDICA">Licencia Médica</option>
                                    <option value="AJUSTE_ASISTENCIA">Permiso Administrativo / Ajuste</option>
                                </select>
                            </div>

                            <!-- Documento de Respaldo -->
                            <div class="mb-4">
                                <label class="form-label text-muted small fw-semibold">Documento de Respaldo</label>
                                <input type="file" id="fileRespaldo" name="documentoRespaldo" class="form-control custom-input-field" accept=".pdf,.jpg,.jpeg,.png" required disabled />
                                <small class="text-info mt-1 d-none" id="ocrLoadingText"><i class="bi bi-arrow-repeat spin-icon me-1"></i> Analizando documento para extraer datos...</small>
                            </div>

                            <!-- BLOQUE CONDICIONAL 1: Licencia Médica -->
                            <div id="camposLicencia" class="d-none mb-3 p-3 shadow-sm" style="background: rgba(0,0,0,0.15); border-radius: 10px; border: 1px solid rgba(56,189,248,0.2);">
                                <h6 class="text-info small mb-3"><i class="bi bi-clipboard2-pulse me-1"></i>Detalles Extraídos de Licencia</h6>
                                <p class="small text-muted mb-3" style="font-size: 0.8rem;">Estos datos se completan automáticamente. Verifica que sean correctos.</p>
                                <div class="row g-2 mb-2">
                                    <div class="col-6">
                                        <label class="form-label text-muted small fw-semibold">Folio Documento</label>
                                        <input type="text" id="folio" name="folio" class="form-control custom-input-field form-control-sm" readonly placeholder="Esperando..." />
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label text-muted small fw-semibold">Profesional Emisor</label>
                                        <input type="text" id="profesional" name="profesional" class="form-control custom-input-field form-control-sm" readonly placeholder="Esperando..." />
                                    </div>
                                </div>
                                <div class="row g-2 mb-2">
                                    <div class="col-6">
                                        <label class="form-label text-muted small fw-semibold">Fecha Otorgamiento</label>
                                        <input type="text" id="fechaOtorgamiento" name="fechaOtorgamiento" class="form-control custom-input-field form-control-sm" readonly placeholder="Esperando..." />
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label text-muted small fw-semibold">Fecha de Inicio</label>
                                        <input type="text" id="fechaInicio" name="fechaInicio" class="form-control custom-input-field form-control-sm" readonly placeholder="Esperando..." />
                                    </div>
                                </div>
                                <div class="row g-2 mb-2">
                                    <div class="col-6">
                                        <label class="form-label text-muted small fw-semibold">Días de Reposo</label>
                                        <input type="text" id="diasReposo" name="diasReposo" class="form-control custom-input-field form-control-sm" readonly placeholder="Esperando..." />
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label text-muted small fw-semibold">Tipificación</label>
                                        <input type="text" id="tipificacion" name="tipificacion" class="form-control custom-input-field form-control-sm" readonly placeholder="Esperando..." />
                                    </div>
                                </div>
                            </div>

                            <!-- BLOQUE CONDICIONAL 2: Permiso Administrativo / Ajuste -->
                            <div id="camposAjuste" class="d-none mb-3 p-3 shadow-sm" style="background: rgba(0,0,0,0.15); border-radius: 10px; border: 1px solid rgba(56,189,248,0.2);">
                                <h6 class="text-info small mb-3"><i class="bi bi-clock-history me-1"></i>Detalles Extraídos del Ajuste</h6>
                                <p class="small text-muted mb-3" style="font-size: 0.8rem;">Estos datos se completan automáticamente. Verifica que sean correctos.</p>
                                <div class="row g-2 mb-2">
                                    <div class="col-6">
                                        <label class="form-label text-muted small fw-semibold">Fecha Afectada</label>
                                        <input type="text" id="fechaAfectada" name="fechaAfectada" class="form-control custom-input-field form-control-sm" readonly placeholder="Esperando..." />
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label text-muted small fw-semibold">Emitido Por</label>
                                        <input type="text" id="emitidoPor" name="emitidoPor" class="form-control custom-input-field form-control-sm" readonly placeholder="Esperando..." />
                                    </div>
                                </div>
                                <div class="row g-2 mb-2">
                                    <div class="col-6">
                                        <label class="form-label text-muted small fw-semibold">Hora Entrada</label>
                                        <input type="text" id="horaEntrada" name="horaEntrada" class="form-control custom-input-field form-control-sm" readonly placeholder="Esperando..." />
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label text-muted small fw-semibold">Hora Salida</label>
                                        <input type="text" id="horaSalida" name="horaSalida" class="form-control custom-input-field form-control-sm" readonly placeholder="Esperando..." />
                                    </div>
                                </div>
                                <input type="hidden" id="tipoIncidencia" name="tipoIncidencia" value="NO MARCADA" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label text-muted small fw-semibold">Motivo o Detalle Adicional</label>
                                <textarea id="motivoTextarea" name="motivo" class="form-control custom-input-field" rows="2" placeholder="Agregue información extra si es necesario..." required></textarea>
                            </div>

                            <button type="submit" class="btn btn-submit-custom w-100 shadow-sm" id="btnSubmit">
                                <i class="bi bi-send-fill me-2"></i> Enviar a Recursos Humanos
                            </button>
                        </form>
                    </div>
                </div>

                <!-- Columna Derecha: Solo Preview (Visor Documento) -->
                <div class="col-lg-6 mb-4">
                    <div class="dashboard-card p-3 h-100" id="previewContainer">
                        <label class="text-muted small fw-semibold mb-3 d-flex align-items-center">
                            <i class="bi bi-file-earmark-image text-info me-2 fs-5"></i> Vista Previa del Documento
                        </label>
                        <div class="text-center text-muted" id="emptyPreviewState" style="padding-top: 25%;">
                            <i class="bi bi-cloud-upload fs-1 mb-2"></i>
                            <p class="small">El documento adjunto se visualizará aquí.</p>
                        </div>
                        <iframe id="pdfViewer" style="width: 100%; height: 85%; border: none; border-radius: 8px; background: #fff;" class="d-none"></iframe>
                        <img id="imgViewer" style="width: 100%; max-height: 85%; object-fit: contain; border-radius: 8px;" class="d-none" />
                    </div>
                </div>
            </div>
        </div>

        <!-- PESTAÑA 4: MIS SOLICITUDES (NUEVO) -->
        <div class="tab-pane fade" id="mis-solicitudes-pane" role="tabpanel">
            <div class="dashboard-card p-4">
                <div class="d-flex align-items-center mb-4">
                    <h5 class="text-white mb-0"><i class="bi bi-folder2-open text-info me-2"></i>Historial de Mis Solicitudes</h5>
                </div>

                <div class="table-responsive">
                    <table class="table table-custom align-middle">
                        <thead>
                            <tr>
                                <th>FECHA ENVÍO</th>
                                <th>TIPO TRÁMITE</th>
                                <th>MI MOTIVO</th>
                                <th>ESTADO</th>
                                <th>RESPUESTA RRHH</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.MisSolicitudes != null && ((IEnumerable<control_asistencia.Models.Solicitudes>)ViewBag.MisSolicitudes).Any())
                            {
                                foreach (var item in (IEnumerable<control_asistencia.Models.Solicitudes>)ViewBag.MisSolicitudes)
                                {
                                    <tr>
                                        <td>@item.CreateAt.ToString("dd/MM/yyyy")</td>
                                        <td>
                                            @if (item.TipoSolicitud == "LICENCIA_MEDICA")
                                            {
                                                <span class="badge bg-primary text-white"><i class="bi bi-heart-pulse-fill me-1"></i> Licencia</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-info text-dark"><i class="bi bi-calendar2-check-fill me-1"></i> Ajuste</span>
                                            }
                                        </td>
                                        <td class="text-muted small">@item.Motivo</td>
                                        <td>
                                            @if (item.EstadoSolicitud == "PENDIENTE")
                                            {
                                                <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i> Pendiente</span>
                                            }
                                            else if (item.EstadoSolicitud == "APROBADO")
                                            {
                                                <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> Aprobado</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i> Rechazado</span>
                                            }
                                        </td>
                                        <td class="text-muted small">
                                            @{
                                                var respuestaLog = item.Logs.OrderByDescending(l => l.CreateAt).FirstOrDefault();
                                                if (respuestaLog != null)
                                                {
                                                    @respuestaLog.Respuesta
                                                }
                                                else
                                                {
                                                    <span class="fst-italic opacity-50">Esperando revisión...</span>
                                                }
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">No has enviado ninguna solicitud todavía.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        // 1. Selector de Mes con redirección dinámica
        document.getElementById('selectMes').addEventListener('change', function() {
            let mesSeleccionado = this.value;
            window.location.href = `/Trabajador/Index?mes=${mesSeleccionado}`;
        });

        // 2. Control Sincronizado e inteligente de la Clave Dinámica (Polling)
        const progressBar = document.getElementById('codeProgressBar');
        const timerText = document.getElementById('codeTimerText');
        const codeDisplay = document.getElementById('displayCode');

        let timeLeft = 60;
        let totalCycle = 60;
        let claveActual = '';
        let isSyncing = false;

        async function refrescarClaveDinamicaDesdeServidor(esReintento = false) {
            try {
                let response = await fetch('/Trabajador/ObtenerClaveDinamicaActual');
                if (response.ok) {
                    let data = await response.json();
                    if (esReintento && data.claveDinamica === claveActual) {
                        return false;
                    }
                    claveActual = data.claveDinamica;
                    codeDisplay.innerText = data.claveDinamica;
                    if (data.segundosRestantes !== undefined) {
                        timeLeft = data.segundosRestantes;
                    }
                    return true;
                }
            } catch (error) {
                console.error("Error consultando servidor:", error);
            }
            return false;
        }

        async function procesarSincronizacionSegura() {
            isSyncing = true;
            timerText.innerText = "Sincronizando con base de datos...";
            progressBar.style.width = '100%';
            progressBar.className = 'progress-bar bg-warning progress-bar-striped progress-bar-animated';

            let claveActualizada = false;
            while (!claveActualizada) {
                claveActualizada = await refrescarClaveDinamicaDesdeServidor(true);
                if (!claveActualizada) {
                    await new Promise(resolve => setTimeout(resolve, 1000));
                }
            }
            progressBar.className = 'progress-bar bg-info';
            isSyncing = false;
        }

        function updateTimer() {
            if (isSyncing) return;
            timeLeft--;
            if (timeLeft <= 0) {
                procesarSincronizacionSegura();
                return;
            }
            let percentage = (timeLeft / totalCycle) * 100;
            progressBar.style.width = percentage + '%';
            timerText.innerText = `Actualizando en ${timeLeft}s...`;
            if (timeLeft <= 10) {
                progressBar.classList.replace('bg-info', 'bg-danger');
            } else {
                progressBar.classList.replace('bg-danger', 'bg-info');
            }
        }

        refrescarClaveDinamicaDesdeServidor().then(() => {
            setInterval(updateTimer, 1000);
        });

        // 3. Lógica Formulario: Ocultar y Mostrar Bloques
        const selectTipoSolicitud = document.getElementById('tipoSolicitud');
        const fileInput = document.getElementById('fileRespaldo');
        const camposLicencia = document.getElementById('camposLicencia');
        const camposAjuste = document.getElementById('camposAjuste');

        selectTipoSolicitud.addEventListener('change', function() {
            fileInput.removeAttribute('disabled');
            camposLicencia.classList.add('d-none');
            camposAjuste.classList.add('d-none');

            if (this.value === 'LICENCIA_MEDICA') {
                camposLicencia.classList.remove('d-none');
            } else if (this.value === 'AJUSTE_ASISTENCIA') {
                camposAjuste.classList.remove('d-none');
            }
        });

        // 4. Lógica OCR, Visor y Bloqueo de Botón durante transcripción
        const pdfViewer = document.getElementById('pdfViewer');
        const imgViewer = document.getElementById('imgViewer');
        const emptyState = document.getElementById('emptyPreviewState');
        const loadingText = document.getElementById('ocrLoadingText');
        const btnSubmit = document.getElementById('btnSubmit');

        fileInput.addEventListener('change', function() {
            const file = this.files[0];
            if (!file) return;

            emptyState.classList.add('d-none');
            pdfViewer.classList.add('d-none');
            imgViewer.classList.add('d-none');

            const fileURL = URL.createObjectURL(file);
            if (file.type === 'application/pdf') {
                pdfViewer.src = fileURL;
                pdfViewer.classList.remove('d-none');
            } else if (file.type.startsWith('image/')) {
                imgViewer.src = fileURL;
                imgViewer.classList.remove('d-none');
            }

            loadingText.classList.remove('d-none');
            btnSubmit.setAttribute('disabled', 'true');
            btnSubmit.innerHTML = `<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Transcribiendo documento...`;

            let formData = new FormData();
            formData.append("documento", file);
            formData.append("tipoSolicitud", selectTipoSolicitud.value);

            fetch('/Trabajador/ExtraerDatosLicencia', {
                method: 'POST',
                body: formData
            })
            .then(async response => {
                if(!response.ok) {
                    let errorText = await response.text();
                    throw new Error(errorText);
                }
                return response.json();
            })
            .then(data => {
                loadingText.classList.add('d-none');
                btnSubmit.removeAttribute('disabled');
                btnSubmit.innerHTML = `<i class="bi bi-send-fill me-2"></i> Enviar a Recursos Humanos`;

                let fieldsMap = [];
                if (selectTipoSolicitud.value === 'LICENCIA_MEDICA') {
                    fieldsMap = [
                        { id: 'folio', val: data.folio || 'Revisar manual' },
                        { id: 'profesional', val: data.profesional || 'Revisar manual' },
                        { id: 'fechaOtorgamiento', val: data.fechaOtorgamiento || 'Revisar manual' },
                        { id: 'fechaInicio', val: data.fechaInicio || 'Revisar manual' },
                        { id: 'diasReposo', val: data.diasReposo || 'Revisar manual' },
                        { id: 'tipificacion', val: data.tipificacion || 'TIPO_1' }
                    ];
                } else if (selectTipoSolicitud.value === 'AJUSTE_ASISTENCIA') {
                    fieldsMap = [
                        { id: 'fechaAfectada', val: data.fechaAfectada || 'Revisar manual' },
                        { id: 'emitidoPor', val: data.emitidoPor || 'Revisar manual' },
                        { id: 'horaEntrada', val: data.horaEntrada || 'Revisar manual' },
                        { id: 'horaSalida', val: data.horaSalida || 'Revisar manual' },
                        { id: 'tipoIncidencia', val: data.tipoIncidencia || 'NO MARCADA' }
                    ];
                }

                fieldsMap.forEach(field => {
                    let el = document.getElementById(field.id);
                    if(el) {
                        el.value = field.val;
                        el.classList.add('highlight-ocr');
                        setTimeout(() => el.classList.remove('highlight-ocr'), 2000);
                    }
                });
            })
            .catch(error => {
                console.error("Error OCR Backend:", error);
                loadingText.classList.add('d-none');
                btnSubmit.removeAttribute('disabled');
                btnSubmit.innerHTML = `<i class="bi bi-send-fill me-2"></i> Enviar a Recursos Humanos`;
                alert("Fallo la extracción: " + error.message);
            });
        });
    </script>
}