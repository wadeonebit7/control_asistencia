@{
    ViewData["Title"] = "Iniciar Sesión - Control de Asistencia";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<style>
    /* Fondo general de la página corporativo y profesional */
    body {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f172a 100%);
        min-height: 100vh;
        color: #e2e8f0;
    }

    /* Estilo moderno tipo Glassmorphism para la tarjeta de login */
    .login-card {
        background: rgba(30, 41, 59, 0.75);
        border: 1px solid rgba(56, 189, 248, 0.15);
        border-radius: 20px;
        backdrop-filter: blur(12px);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
    }

    /* Título principal con tono profesional */
    .title-attendance {
        color: #38bdf8;
        font-weight: 700;
        letter-spacing: 0.5px;
        font-size: 1.6rem;
    }

    /* Inputs estilizados */
    .custom-input {
        background: rgba(15, 23, 42, 0.6) !important;
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        color: #f8fafc !important;
        border-radius: 10px;
        padding: 12px 14px;
        font-size: 0.95rem;
        transition: all 0.3s ease;
    }

        .custom-input:focus {
            border-color: #38bdf8 !important;
            box-shadow: 0 0 0 0.2rem rgba(56, 189, 248, 0.25) !important;
            background: rgba(15, 23, 42, 0.9) !important;
        }

    /* Iconos del input */
    .custom-addon {
        background: rgba(15, 23, 42, 0.8) !important;
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        color: #38bdf8 !important;
        border-top-left-radius: 10px;
        border-bottom-left-radius: 10px;
        padding: 0 14px;
    }

    /* Botón de ingreso corporativo */
    .btn-login-attendance {
        background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
        border: none;
        border-radius: 10px;
        padding: 12px 20px;
        font-weight: 600;
        letter-spacing: 0.5px;
        transition: all 0.3s ease;
    }

        .btn-login-attendance:hover {
            background: linear-gradient(135deg, #0369a1 0%, #075985 100%);
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(2, 132, 199, 0.4);
        }

    /* Etiquetas de los campos */
    .form-label-custom {
        color: #cbd5e1;
        font-size: 0.9rem;
        font-weight: 500;
    }
</style>

<div class="container d-flex justify-content-center align-items-center" style="min-height: 85vh;">
    <div class="card login-card p-4 w-100" style="max-width: 420px;">
        <div class="card-body">

            <!-- Cabecera orientada a asistencia -->
            <div class="text-center mb-4">
                <div class="mb-3">
                    <i class="bi bi-clock-history p-3 rounded-circle" style="font-size: 2.2rem; color: #38bdf8; background: rgba(56, 189, 248, 0.1);"></i>
                </div>
                <h2 class="title-attendance mb-1">CONTROL DE ASISTENCIA</h2>
                <p class="text-muted small">Plataforma de Gestión de Personal</p>
            </div>

            <!-- Alerta de Error -->
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 rounded-3 small p-2 text-center mb-4" role="alert">
                    <i class="bi bi-exclamation-circle-fill me-2"></i>@ViewBag.Error
                </div>
            }

            <!-- Formulario de acceso -->
            <form asp-controller="Usuarios" asp-action="Login" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label-custom mb-2">Correo Electrónico</label>
                    <div class="input-group">
                        <span class="input-group-text custom-addon"><i class="bi bi-envelope-fill"></i></span>
                        <input name="Correo" type="email" class="form-control custom-input" placeholder="ejemplo@empresa.com" required autocomplete="off" />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label-custom mb-2">Contraseña</label>
                    <div class="input-group">
                        <span class="input-group-text custom-addon"><i class="bi bi-shield-lock-fill"></i></span>
                        <input name="Password" type="password" class="form-control custom-input" placeholder="••••••••" required />
                    </div>
                </div>

                <div>
                    <button type="submit" class="btn btn-login-attendance w-100 text-white shadow-sm">
                        <i class="bi bi-box-arrow-in-right me-2"></i> Iniciar Sesión
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>