
@{
}

@{
    ViewData["Title"] = "Iniciar Sesión";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<style>
    .login-card {
        background: rgba(20, 30, 48, 0.85);
        border: 1px solid rgba(100, 181, 246, 0.2);
        border-radius: 16px;
        backdrop-filter: blur(10px);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
    }

    .title-dragon {
        color: #64b5f6;
        font-weight: 800;
        letter-spacing: 1px;
    }

    .custom-input {
        background: rgba(255, 255, 255, 0.07) !important;
        border: 1px solid rgba(255, 255, 255, 0.15) !important;
        color: #ffffff !important;
        border-radius: 8px;
        padding: 10px 12px;
        transition: all 0.3s ease;
    }

        .custom-input:focus {
            border-color: #64b5f6 !important;
            box-shadow: 0 0 0 0.25rem rgba(100, 181, 246, 0.25) !important;
        }

    .custom-addon {
        background: rgba(255, 255, 255, 0.05) !important;
        border: 1px solid rgba(255, 255, 255, 0.15) !important;
        color: #90caf9 !important;
    }

    .btn-login-dragon {
        background-color: #1e3c72;
        border: none;
        border-radius: 8px;
        padding: 10px 20px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .btn-login-dragon:hover {
            background-color: #2a5298;
            transform: translateY(-1px);
            box-shadow: 0 4px 15px rgba(42, 82, 152, 0.4);
        }
</style>

<div class="container py-5 d-flex justify-content-center align-items-center" style="min-height: 75vh;">
    <div class="card login-card p-3 w-100" style="max-width: 420px;">
        <div class="card-body">

            <div class="text-center mb-4">
                <i class="bi bi-person-circle" style="font-size: 3rem; color: #90caf9;"></i>
                <h2 class="title-dragon mt-2">INGRESAR</h2>
                <p class="text-secondary small">Dragones de la pelota</p>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger bg-opacity-10 bg-danger text-danger border border-danger border-opacity-25 small p-2 text-center" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@ViewBag.Error
                </div>
            }

            <form method="post" asp-action="Login">
                @Html.AntiForgeryToken()

                <div class="form-group mb-3">
                    <label class="control-label fw-semibold text-light mb-2">Usuario</label>
                    <div class="input-group">
                        <span class="input-group-text custom-addon"><i class="bi bi-person-fill"></i></span>
                        <input name="username" type="text" class="form-control custom-input" required autocomplete="off" />
                    </div>
                </div>

                <div class="form-group mb-4">
                    <label class="control-label fw-semibold text-light mb-2">Contraseña</label>
                    <div class="input-group">
                        <span class="input-group-text custom-addon"><i class="bi bi-lock-fill"></i></span>
                        <input name="password" type="password" class="form-control custom-input" required />
                    </div>
                </div>

                <div class="pt-2">
                    <button type="submit" class="btn btn-login-dragon w-100 text-white shadow-sm">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar Sesión
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>