@{
    ViewData["Title"] = "Acceso con Clave Dinámica";
    bool jornadaHabilitada = ViewBag.JornadaHabilitada ?? false;
    var errorMessage = ViewBag.Error ?? TempData["Error"];
    var mensajeExito = ViewBag.MensajeExito ?? TempData["Mensaje"];
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<style>
    body {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f172a 100%);
        min-height: 100vh;
        color: #e2e8f0;
        position: relative;
        transition: background 0.5s ease;
    }

    .login-card {
        background: rgba(30, 41, 59, 0.75);
        border: 1px solid rgba(56, 189, 248, 0.15);
        border-radius: 20px;
        backdrop-filter: blur(12px);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
        transition: all 0.4s ease;
    }

    .card-success {
        border-color: #10b981 !important;
        box-shadow: 0 0 35px rgba(16, 185, 129, 0.5) !important;
        background: rgba(6, 78, 59, 0.85) !important;
    }

    .card-error {
        border-color: #ef4444 !important;
        box-shadow: 0 0 35px rgba(239, 68, 68, 0.5) !important;
        background: rgba(127, 29, 29, 0.85) !important;
    }

    .title-attendance {
        color: #38bdf8;
        font-weight: 700;
        letter-spacing: 0.5px;
        font-size: 1.5rem;
    }

    .custom-input {
        background: rgba(15, 23, 42, 0.6) !important;
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        color: #f8fafc !important;
        border-radius: 10px;
        padding: 12px 14px;
        font-size: 1.1rem;
        letter-spacing: 2px;
        transition: all 0.3s ease;
    }

        .custom-input:focus {
            border-color: #38bdf8 !important;
            box-shadow: 0 0 0 0.2rem rgba(56, 189, 248, 0.25) !important;
            background: rgba(15, 23, 42, 0.9) !important;
        }

        .custom-input:disabled {
            background: rgba(15, 23, 42, 0.3) !important;
            color: #64748b !important;
            cursor: not-allowed;
        }

    .custom-addon {
        background: rgba(15, 23, 42, 0.8) !important;
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        color: #38bdf8 !important;
        border-top-left-radius: 10px;
        border-bottom-left-radius: 10px;
        padding: 0 16px;
    }

    .btn-login-dragon {
        background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
        border: none;
        border-radius: 10px;
        padding: 12px 20px;
        font-weight: 600;
        letter-spacing: 0.5px;
        transition: all 0.3s ease;
    }

        .btn-login-dragon:hover:not(:disabled) {
            background: linear-gradient(135deg, #0369a1 100%, #075985 100%);
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(2, 132, 199, 0.4);
        }

        .btn-login-dragon:disabled {
            background: #334155;
            color: #94a3b8 !important;
            cursor: not-allowed;
            opacity: 0.7;
            box-shadow: none;
        }

    .form-label-custom {
        color: #cbd5e1;
        font-size: 0.9rem;
        font-weight: 500;
    }

    .admin-access-btn {
        position: fixed;
        bottom: 20px;
        right: 25px;
        z-index: 9999;
        background: rgba(15, 23, 42, 0.6);
        border: 1px solid rgba(56, 189, 248, 0.2);
        padding: 8px 16px;
        border-radius: 30px;
        color: #94a3b8;
        font-size: 0.85rem;
        text-decoration: none;
        backdrop-filter: blur(8px);
        transition: all 0.3s ease;
    }

        .admin-access-btn:hover {
            background: rgba(2, 132, 199, 0.2);
            color: #38bdf8;
            border-color: rgba(56, 189, 248, 0.5);
        }
</style>

<div class="container d-flex justify-content-center align-items-center" style="min-height: 85vh;">
    <div id="mainCard" class="card login-card p-4 w-100 @(errorMessage != null ? "card-error" : (mensajeExito != null ? "card-success" : ""))" style="max-width: 440px;">
        <div class="card-body">

            <div class="text-center mb-4">
                <div class="mb-3">
                    <i class="bi bi-ticket-perforated p-3 rounded-circle" style="font-size: 2.2rem; color: #38bdf8; background: rgba(56, 189, 248, 0.1);"></i>
                </div>
                <h2 class="title-attendance mb-1">ACCESO CON TICKET</h2>
                <p class="text-muted small">Ingresa tu clave dinámica de asistencia</p>
            </div>

            @if (mensajeExito != null)
            {
                <div id="alertaTemporal" class="alert alert-success d-flex align-items-center mb-4 p-3 shadow" role="alert" style="border-radius: 12px; background: rgba(16, 185, 129, 0.2); border: 1px solid rgba(16, 185, 129, 0.4); color: #34d399;">
                    <i class="bi bi-check-circle-fill fs-3 me-3"></i>
                    <div style="font-size: 0.95rem; line-height: 1.3; text-align: left; font-weight: 600;">
                        @mensajeExito
                    </div>
                </div>
            }

            @if (errorMessage != null)
            {
                <div id="alertaTemporal" class="alert alert-danger d-flex align-items-center mb-4 p-3 shadow" role="alert" style="border-radius: 12px; background: rgba(220, 38, 38, 0.2); border: 1px solid rgba(220, 38, 38, 0.4); color: #fca5a5;">
                    <i class="bi bi-exclamation-triangle-fill fs-3 me-3"></i>
                    <div style="font-size: 0.95rem; line-height: 1.3; text-align: left; font-weight: 600;">
                        @errorMessage
                    </div>
                </div>
            }

            @if (!jornadaHabilitada)
            {
                <div class="alert alert-warning d-flex align-items-center mb-4 p-3" role="alert" style="border-radius: 12px; background: rgba(245, 158, 11, 0.15); border: 1px solid rgba(245, 158, 11, 0.3); color: #fcd34d;">
                    <i class="bi bi-clock-history fs-2 me-3"></i>
                    <div style="font-size: 0.95rem; line-height: 1.3; text-align: left;">
                        <strong>Sistema Inactivo:</strong><br />
                        La asistencia no ha sido habilitada o el turno operativo ya ha finalizado.
                    </div>
                </div>
            }

            <form asp-controller="Trabajador" asp-action="LoginClaveDinamica" method="post">
                <div class="mb-4">
                    <label class="form-label-custom mb-2">Clave Dinámica</label>
                    <div class="input-group">
                        <span class="input-group-text custom-addon"><i class="bi bi-key-fill"></i></span>
                        <input name="claveDinamica" type="text" class="form-control custom-input text-uppercase text-center fw-bold"
                               maxlength="8" placeholder="CAMI12" required autocomplete="off" autofocus
                        @(jornadaHabilitada ? "" : "disabled") />
                    </div>
                    <small class="text-muted d-block mt-2 text-center">Código único de hasta 8 caracteres.</small>
                </div>

                <div>
                    <button type="submit" class="btn btn-login-dragon w-100 text-white shadow-sm"
                        @(jornadaHabilitada ? "" : "disabled")>
                        <i class="bi bi-box-arrow-in-right me-2"></i> Ingresar con Ticket
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

<a href="@Url.Action("AdminVerificacion", "Auth")" class="admin-access-btn" title="Verificación de Administrador">
    <i class="bi bi-shield-lock-fill me-1"></i> Acceso Admin
</a>

<script>
    function reproducirSonido(tipo) {
        try {
            const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.connect(gain);
            gain.connect(audioCtx.destination);

            if (tipo === 'exito') {
                osc.type = 'sine';
                osc.frequency.setValueAtTime(587.33, audioCtx.currentTime);
                osc.frequency.setValueAtTime(880, audioCtx.currentTime + 0.1);
                gain.gain.setValueAtTime(0.15, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.4);
                osc.start();
                osc.stop(audioCtx.currentTime + 0.4);
            } else {
                osc.type = 'sawtooth';
                osc.frequency.setValueAtTime(150, audioCtx.currentTime);
                osc.frequency.setValueAtTime(100, audioCtx.currentTime + 0.15);
                gain.gain.setValueAtTime(0.2, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.35);
                osc.start();
                osc.stop(audioCtx.currentTime + 0.35);
            }
        } catch (e) {
            console.log("Audio bloqueado o no soportado.");
        }
    }

    document.addEventListener("DOMContentLoaded", () => {
        const hasError = @Json.Serialize(errorMessage != null);
        const hasSuccess = @Json.Serialize(mensajeExito != null);

        if (hasError) {
            reproducirSonido('error');

            // Después de 3 segundos (3000 ms), quitamos el rojo y volvemos a la normalidad
            setTimeout(() => {
                const alerta = document.getElementById('alertaTemporal');
                const tarjeta = document.getElementById('mainCard');
                if (alerta) {
                    alerta.style.transition = "opacity 0.5s ease";
                    alerta.style.opacity = "0";
                    setTimeout(() => alerta.remove(), 500);
                }
                if (tarjeta) {
                    tarjeta.classList.remove('card-error');
                    // Forzamos el restablecimiento visual a los estilos base
                    tarjeta.style.background = "rgba(30, 41, 59, 0.75)";
                    tarjeta.style.borderColor = "rgba(56, 189, 248, 0.15)";
                    tarjeta.style.boxShadow = "0 20px 40px rgba(0, 0, 0, 0.4)";
                }
            }, 3000); // 3 segundos para el rojo

        } else if (hasSuccess) {
            reproducirSonido('exito');

            setTimeout(() => {
                const alerta = document.getElementById('alertaTemporal');
                const tarjeta = document.getElementById('mainCard');
                if (alerta) {
                    alerta.style.transition = "opacity 0.5s ease";
                    alerta.style.opacity = "0";
                    setTimeout(() => alerta.remove(), 500);
                }
                if (tarjeta) {
                    tarjeta.classList.remove('card-success');
                    tarjeta.style.background = "rgba(30, 41, 59, 0.75)";
                    tarjeta.style.borderColor = "rgba(56, 189, 248, 0.15)";
                    tarjeta.style.boxShadow = "0 20px 40px rgba(0, 0, 0, 0.4)";
                }
            }, 4000); // 4 segundos para el verde
        }
    });
</script>