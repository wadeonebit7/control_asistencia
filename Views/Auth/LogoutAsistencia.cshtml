@{
    ViewData["Title"] = "Acceso con Clave Dinámica";
    bool jornadaHabilitada = ViewBag.JornadaHabilitada ?? false;
    var errorMessage = ViewBag.Error ?? TempData["Error"];
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

<style>
    body {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f172a 100%);
        min-height: 100vh;
        color: #e2e8f0;
    }

    .login-card {
        background: rgba(30, 41, 59, 0.75);
        border: 1px solid rgba(56, 189, 248, 0.15);
        border-radius: 20px;
        backdrop-filter: blur(12px);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
    }

    .title-attendance {
        color: #38bdf8;
        font-weight: 700;
        letter-spacing: 0.5px;
        font-size: 1.5rem;
    }

    .custom-input {
        background: rgba(15, 23, 42, 0.6) !important;
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        color: #f8fafc !important;
        border-radius: 10px;
        padding: 12px 14px;
        font-size: 1.1rem;
        letter-spacing: 2px;
        transition: all 0.3s ease;
    }

        .custom-input:focus {
            border-color: #38bdf8 !important;
            box-shadow: 0 0 0 0.2rem rgba(56, 189, 248, 0.25) !important;
            background: rgba(15, 23, 42, 0.9) !important;
        }

        .custom-input:disabled {
            background: rgba(15, 23, 42, 0.3) !important;
            color: #64748b !important;
            cursor: not-allowed;
        }

    .custom-addon {
        background: rgba(15, 23, 42, 0.8) !important;
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        color: #38bdf8 !important;
        border-top-left-radius: 10px;
        border-bottom-left-radius: 10px;
        padding: 0 16px;
    }

    .btn-login-dragon {
        background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
        border: none;
        border-radius: 10px;
        padding: 12px 20px;
        font-weight: 600;
        letter-spacing: 0.5px;
        transition: all 0.3s ease;
    }

        .btn-login-dragon:hover:not(:disabled) {
            background: linear-gradient(135deg, #0369a1 100%, #075985 100%);
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(2, 132, 199, 0.4);
        }

        .btn-login-dragon:disabled {
            background: #334155;
            color: #94a3b8 !important;
            cursor: not-allowed;
            opacity: 0.7;
            box-shadow: none;
        }

    .form-label-custom {
        color: #cbd5e1;
        font-size: 0.9rem;
        font-weight: 500;
    }
</style>

<div class="container d-flex justify-content-center align-items-center" style="min-height: 85vh;">
    <div class="card login-card p-4 w-100" style="max-width: 440px;">
        <div class="card-body">

            <div class="text-center mb-4">
                <div class="mb-3">
                    <i class="bi bi-ticket-perforated p-3 rounded-circle" style="font-size: 2.2rem; color: #38bdf8; background: rgba(56, 189, 248, 0.1);"></i>
                </div>
                <h2 class="title-attendance mb-1">ACCESO CON TICKET</h2>
                <p class="text-muted small">Ingresa tu clave dinámica de asistencia</p>
            </div>

            <!-- Alerta Grande de Error -->
            @if (errorMessage != null)
            {
                <div class="alert alert-danger d-flex align-items-center mb-4 p-3" role="alert" style="border-radius: 12px; background: rgba(220, 38, 38, 0.15); border: 1px solid rgba(220, 38, 38, 0.3); color: #fca5a5;">
                    <i class="bi bi-exclamation-triangle-fill fs-3 me-3"></i>
                    <div style="font-size: 0.95rem; line-height: 1.3; text-align: left;">
                        @errorMessage
                    </div>
                </div>
            }

            <!-- Alerta Informativa de Turno Inactivo o Fuera de Horario -->
            @if (!jornadaHabilitada)
            {
                <div class="alert alert-warning d-flex align-items-center mb-4 p-3" role="alert" style="border-radius: 12px; background: rgba(245, 158, 11, 0.15); border: 1px solid rgba(245, 158, 11, 0.3); color: #fcd34d;">
                    <i class="bi bi-clock-history fs-2 me-3"></i>
                    <div style="font-size: 0.95rem; line-height: 1.3; text-align: left;">
                        <strong>Sistema Inactivo:</strong><br />
                        La asistencia no ha sido habilitada o el turno operativo ya ha finalizado.
                    </div>
                </div>
            }

            <form asp-controller="Trabajador" asp-action="LoginClaveDinamica" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-4">
                    <label class="form-label-custom mb-2">Clave Dinámica</label>
                    <div class="input-group">
                        <span class="input-group-text custom-addon"><i class="bi bi-key-fill"></i></span>
                        <input name="claveDinamica" type="text" class="form-control custom-input text-uppercase text-center fw-bold"
                               maxlength="8" placeholder="CAMI12" required autocomplete="off"
                        @(jornadaHabilitada ? "" : "disabled") />
                    </div>
                    <small class="text-muted d-block mt-2 text-center">Código único de hasta 8 caracteres.</small>
                </div>

                <div>
                    <button type="submit" class="btn btn-login-dragon w-100 text-white shadow-sm"
                        @(jornadaHabilitada ? "" : "disabled")>
                        <i class="bi bi-box-arrow-in-right me-2"></i> Ingresar con Ticket
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>